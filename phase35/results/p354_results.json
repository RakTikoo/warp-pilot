{
  "item": "P35-4 xi phi^2 T scalar-torsion",
  "theory": "f(T,phi)=-(1-xi phi^2) T, F=df/dT=xi phi^2-1, canonical scalar",
  "units": "r0=1, 4pi-normalised matter (P33-4 record)",
  "background_note": "T==0 with tetrad of record forces a'=(s-1)/r (BHL Eq.25), e^a=(1+s)/2; literal Phi=0 (a=0) gives T!=0, outside class.",
  "T_verification": {
    "T_simplified": "0",
    "T_is_zero": true
  },
  "throat_limits_F_coefficients": {
    "rho_eq13_F_coeff_limit": -0.5,
    "pr_eq14_F_coeff_limit": -0.5,
    "pt_eq15_F_coeff_limit": 0.375
  },
  "derivative_terms_at_throat": {
    "F_prime": "2 xi phi phi' (f_{T phi} phi'; T'=0 on background)",
    "D_rho_4pi": "lim s(1-s)/r * F' = 2 xi phi(r0) L,  L := lim s(r) phi'(r)",
    "D_pt_4pi": "lim (e^-b/2)(a'/2+1/r-e^{b/2}/r) F' = -xi phi(r0) L = -D_rho/2",
    "D_pr_4pi": 0.0,
    "pr_note": "BHL Eq.(14) contains NO T' f_TT term at any r: the pr throat equation receives no S.dF contribution whatsoever.",
    "finiteness": "coeffs vanish like s, but a throat-regular scalar has phi' ~ L/s (flux J0 != 0), so s F' -> 2 xi phi0 L finite. If J0 = 0 (L=0) the terms vanish and the P33-4 identity is restored."
  },
